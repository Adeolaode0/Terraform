# Copy to terraform.tfvars and adjust, or pass -var flags.
aws_region           = "us-east-1"
environment          = "dev"
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
instance_type        = "t3.micro"
asg_min_size         = 1
asg_max_size         = 3
asg_desired_capacity = 2

# Observability (all optional): CloudWatch CPU alarm + SNS alert topic.
# Leave notification_email commented out (or empty) to create the topic
# with no subscriptions; set an address to get alarm emails (AWS requires
# the subscriber to click the confirmation link in the email it sends).
# enable_cpu_alarm    = true
# cpu_alarm_threshold = 80
# notification_email  = "you@example.com"
